{
  "info": {
    "name": "Sesión 8 · DTOs y paginación (Estudiante)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090/api/estudiante"
    }
  ],
  "item": [
    {
      "name": "POST con datos válidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"joaquin\",\n  \"correo\": \"joaquin@uamv.edu.ni\",\n  \"edad\": 21\n}"
        },
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "POST con datos inválidos",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"j\",\n  \"correo\": \"no-es-un-correo\",\n  \"edad\": -3\n}"
        },
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "GET página 0 (size 3)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?page=0&size=3"
      }
    },
    {
      "name": "GET página 1 (size 3)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?page=1&size=3"
      }
    },
    {
      "name": "GET página 0 (size 5)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}?page=0&size=5"
      }
    },
    {
      "name": "GET sin parámetros (valores por defecto)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}"
      }
    }
  ]
}
